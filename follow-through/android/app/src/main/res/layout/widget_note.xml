<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/n_root"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical"
    android:padding="12dp" android:background="@drawable/sticky_honey">
    <TextView android:id="@+id/n_title" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:fontFamily="@font/patrick_hand" android:textColor="#1E1606" android:textSize="21sp" android:maxLines="2" android:ellipsize="end" android:text="Your pinned note" />
    <TextView android:id="@+id/n_body" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="#1E1606" android:textSize="12sp" android:maxLines="3" android:ellipsize="end" android:visibility="gone" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical">
        <TextView android:id="@+id/n_i0" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="#1E1606" android:textSize="13sp" android:paddingTop="3dp" android:paddingBottom="3dp" android:maxLines="1" android:ellipsize="end" android:visibility="gone" />
        <TextView android:id="@+id/n_i1" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="#1E1606" android:textSize="13sp" android:paddingTop="3dp" android:paddingBottom="3dp" android:maxLines="1" android:ellipsize="end" android:visibility="gone" />
        <TextView android:id="@+id/n_i2" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="#1E1606" android:textSize="13sp" android:paddingTop="3dp" android:paddingBottom="3dp" android:maxLines="1" android:ellipsize="end" android:visibility="gone" />
        <TextView android:id="@+id/n_i3" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="#1E1606" android:textSize="13sp" android:paddingTop="3dp" android:paddingBottom="3dp" android:maxLines="1" android:ellipsize="end" android:visibility="gone" />
    </LinearLayout>
    <TextView android:id="@+id/n_rem" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:background="@drawable/wcard_chip" android:paddingLeft="8dp" android:paddingRight="8dp" android:paddingTop="2dp" android:paddingBottom="2dp"
        android:textColor="#1E1606" android:textSize="11sp" android:textStyle="bold" android:visibility="gone" />
</LinearLayout>
