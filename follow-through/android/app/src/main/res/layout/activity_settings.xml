<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Settings" android:textSize="28sp" android:textStyle="bold"
            android:textColor="@color/accent" />
        <TextView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Connect your sheet, turn on instant sorting, and switch on the bubble. Press back to return to your dashboard." />

        <!-- Step 1 -->
        <TextView
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="1 · Connect your Google Sheet" android:textSize="18sp" android:textStyle="bold" />
        <TextView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Paste your Web app link from Apps Script (it starts with https://script.google.com/macros/s/ and ends with /exec). Your tracker sheet is created automatically the first time it connects." />
        <EditText
            android:id="@+id/code"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/field_bg"
            android:hint="https://script.google.com/macros/s/…/exec"
            android:inputType="textUri" android:minLines="2" android:gravity="top" />
        <Button
            android:id="@+id/connect"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Save &amp; test" />
        <TextView
            android:id="@+id/connStatus"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="4dp" />
        <Button
            android:id="@+id/openSheet"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:visibility="gone"
            android:text="Open my tracker sheet" />

        <!-- Step 1b: Gemini -->
        <TextView
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="2 · Turn on instant sorting (free)" android:textSize="18sp" android:textStyle="bold" />
        <TextView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="A free Gemini key lets your sheet sort each capture within seconds, write essay drafts and tailor your CV. Tap “Get a free key”, sign in, tap Create API key, copy it, and paste it here. It's stored only in your own Google script." />
        <Button
            android:id="@+id/getKey"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Get a free key" />
        <EditText
            android:id="@+id/key"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/field_bg"
            android:hint="Paste your Gemini API key"
            android:inputType="textPassword" />
        <Button
            android:id="@+id/saveKey"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Save key" />
        <TextView
            android:id="@+id/keyStatus"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="4dp" />

        <!-- Step 2 -->
        <TextView
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="3 · Turn on the bubble" android:textSize="18sp" android:textStyle="bold" />
        <TextView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Android asks for Accessibility access so the bubble can float over other apps and read the screen when you tap it. It reads nothing until you tap, and skips password fields.\n\nIf the switch is greyed out: open App info → ⋮ menu → “Allow restricted settings”, then try again." />
        <TextView
            android:id="@+id/bubbleStatus"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:textStyle="bold" />
        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginTop="8dp">
            <Button
                android:id="@+id/accessibility"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Open settings" />
            <Button
                android:id="@+id/appInfo"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="App info" />
        </LinearLayout>
        <Button
            android:id="@+id/show"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Show bubble now" />

        <!-- Step 3 -->
        <TextView
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="How to use it" android:textSize="18sp" android:textStyle="bold" />
        <TextView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="• Tap the bubble: saves what's on screen (text, link, screenshot).\n• Drag it: move it anywhere; it tucks into the edge.\n• Hold it: hides it for an hour.\n• No bubble? Use Share → “Save to Follow-Through” from any app." />
        <TextView
            android:id="@+id/queue"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" />
        <Button
            android:id="@+id/flush"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Send waiting captures" />
    </LinearLayout>
</ScrollView>
