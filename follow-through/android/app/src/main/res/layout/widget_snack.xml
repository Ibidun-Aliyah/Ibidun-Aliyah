<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/s_root"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical"
    android:padding="12dp" android:background="@drawable/wcard_lilac">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
        <TextView android:id="@+id/s_kind" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:textColor="#1E1606" android:textSize="11sp" android:textStyle="bold" android:text="WORD OF THE DAY" android:alpha="0.75" />
        <TextView android:id="@+id/s_play" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:background="@drawable/wcard_chip" android:paddingLeft="8dp" android:paddingRight="8dp" android:paddingTop="2dp" android:paddingBottom="2dp"
            android:textColor="#1E1606" android:textSize="11sp" android:textStyle="bold" android:text="Play ▸" />
    </LinearLayout>
    <TextView android:id="@+id/s_q" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:fontFamily="@font/patrick_hand" android:textColor="#1E1606" android:textSize="24sp" android:maxLines="3" android:ellipsize="end" android:text="ephemeral" />
    <TextView android:id="@+id/s_a" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="#1E1606" android:textSize="13sp" android:textStyle="bold" android:maxLines="2" android:ellipsize="end" />
    <TextView android:id="@+id/s_ex" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="#1E1606" android:textSize="12sp" android:textStyle="italic" android:alpha="0.8" android:maxLines="2" android:ellipsize="end" />
    <TextView android:id="@+id/s_hint" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="#1E1606" android:textSize="12sp" android:alpha="0.7" android:text="Tap to reveal" />
</LinearLayout>
