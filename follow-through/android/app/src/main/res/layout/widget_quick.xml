<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/q_root"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal"
    android:gravity="center_vertical" android:padding="5dp" android:background="@drawable/wcard_honey">
    <LinearLayout android:id="@+id/q_voice" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
        android:layout_margin="3dp" android:orientation="horizontal" android:gravity="center" android:minHeight="36dp"
        android:paddingLeft="6dp" android:paddingRight="6dp" android:background="@drawable/wcard_btn">
        <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_w_mic" android:contentDescription="@null" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="5dp"
            android:fontFamily="@font/patrick_hand" android:textColor="#1E1606" android:textSize="16sp" android:maxLines="1" android:ellipsize="end" android:text="Say it" />
    </LinearLayout>
    <LinearLayout android:id="@+id/q_paste" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
        android:layout_margin="3dp" android:orientation="horizontal" android:gravity="center" android:minHeight="36dp"
        android:paddingLeft="6dp" android:paddingRight="6dp" android:background="@drawable/wcard_btn">
        <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_w_link" android:contentDescription="@null" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="5dp"
            android:fontFamily="@font/patrick_hand" android:textColor="#1E1606" android:textSize="16sp" android:maxLines="1" android:ellipsize="end" android:text="Paste" />
    </LinearLayout>
    <LinearLayout android:id="@+id/q_note" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
        android:layout_margin="3dp" android:orientation="horizontal" android:gravity="center" android:minHeight="36dp"
        android:paddingLeft="6dp" android:paddingRight="6dp" android:background="@drawable/wcard_btn">
        <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_w_note" android:contentDescription="@null" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="5dp"
            android:fontFamily="@font/patrick_hand" android:textColor="#1E1606" android:textSize="16sp" android:maxLines="1" android:ellipsize="end" android:text="Note" />
    </LinearLayout>
</LinearLayout>
