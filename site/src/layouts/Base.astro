---
import '../styles/global.css';
import { SITE } from '../site.config';
import { u } from '../lib/url';

interface Props {
  title?: string;
  description?: string;
  type?: 'website' | 'article';
  published?: Date;
  jsonLd?: Record<string, unknown>;
}
const { title, description = SITE.description, type = 'website', published, jsonLd } = Astro.props;
const fullTitle = title ? `${title} · ${SITE.name}` : SITE.title;
const canonical = new URL(Astro.url.pathname, Astro.site);
const path = Astro.url.pathname.replace(import.meta.env.BASE_URL.replace(/\/$/, ''), '') || '/';
const isActive = (p: string) => path.startsWith(p);
const sameAs = [SITE.linkedin, SITE.instagram, SITE.github].filter(Boolean);
const person = {
  '@context': 'https://schema.org', '@type': 'Person', name: SITE.name, url: new URL(u('/'), Astro.site).href,
  jobTitle: 'Mechatronics Engineering Student', sameAs,
  affiliation: { '@type': 'CollegeOrUniversity', name: 'Lagos State University of Science and Technology (LASUSTECH)' },
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={SITE.name} />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href={u('/sitemap-index.xml')} />
    <link rel="icon" href={u('/favicon.svg')} type="image/svg+xml" />
    <meta name="theme-color" content="#24123F" />
    {SITE.googleVerification && <meta name="google-site-verification" content={SITE.googleVerification} />}
    <meta property="og:type" content={type} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE.name} />
    <meta name="twitter:card" content="summary" />
    {published && <meta property="article:published_time" content={published.toISOString()} />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Unbounded:wght@600;700;800&family=Atkinson+Hyperlegible:ital,wght@0,400;0,700;1,400&family=JetBrains+Mono:wght@500;700&display=swap" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd ?? person)} />
  </head>
  <body>
    <header class="site-header">
      <div class="wrap">
        <a class="logo" href={u('/')} aria-label={`${SITE.name}, home`}><span class="ref">U1</span><span class="name">aliyah<span>.</span></span></a>
        <nav class="site-nav" aria-label="Main">
          <a href={u('/log/')} aria-current={isActive('/log') ? 'page' : undefined}>Log</a>
          <a href={u('/about/')} aria-current={isActive('/about') ? 'page' : undefined}>About</a>
          <a href={u('/#say-hi')}>Say hi</a>
        </nav>
      </div>
    </header>
    <main><slot /></main>
    <footer class="site-footer">
      <div class="wrap">
        <span class="silk">© {new Date().getFullYear()} <b>{SITE.name}</b></span>
        <span class="silk">Rev. {new Date().getFullYear()} · Designed &amp; assembled in Lagos</span>
      </div>
    </footer>

    <script is:inline>
    (function () {
      var reduce = window.matchMedia && matchMedia('(prefers-reduced-motion: reduce)').matches;

      // LEDs light up as their post scrolls into view.
      var nodes = document.querySelectorAll('.node');
      if (reduce || !('IntersectionObserver' in window)) nodes.forEach(function (n) { n.classList.add('lit'); });
      else {
        var io = new IntersectionObserver(function (es) {
          es.forEach(function (e) { if (e.isIntersecting) { e.target.classList.add('lit'); io.unobserve(e.target); } });
        }, { rootMargin: '0px 0px -12% 0px' });
        nodes.forEach(function (n) { io.observe(n); });
      }

      // Filter the log by LED colour.
      var filters = document.querySelectorAll('[data-filter]');
      filters.forEach(function (b) {
        b.addEventListener('click', function () {
          b.setAttribute('aria-pressed', b.getAttribute('aria-pressed') === 'true' ? 'false' : 'true');
          var on = {}; filters.forEach(function (f) { on[f.dataset.filter] = f.getAttribute('aria-pressed') === 'true'; });
          var shown = 0;
          nodes.forEach(function (n) { n.hidden = !on[n.dataset.kind]; if (!n.hidden) shown++; });
          var empty = document.getElementById('board-empty'); if (empty) empty.hidden = shown > 0;
        });
      });

      // The helper robot.
      var bot = document.getElementById('bot');
      if (bot) {
        var eyes = bot.querySelector('.eyes'), bubble = document.getElementById('bubble');
        var lines = JSON.parse(bot.getAttribute('data-lines')), i = 0;
        if (!reduce) window.addEventListener('pointermove', function (e) {
          var r = bot.getBoundingClientRect(), cx = r.left + r.width / 2, cy = r.top + r.height * .38;
          var dx = e.clientX - cx, dy = e.clientY - cy, d = Math.hypot(dx, dy) || 1, m = Math.min(7, d / 40);
          eyes.style.transform = 'translate(' + (dx / d * m).toFixed(1) + 'px,' + (dy / d * m * .7).toFixed(1) + 'px)';
        });
        bot.addEventListener('click', function () {
          i = (i + 1) % lines.length; bubble.textContent = lines[i];
          bot.classList.remove('wave'); void bot.offsetWidth; bot.classList.add('wave');
        });
      }
    })();
    </script>
  </body>
</html>
