---
import Base from '../layouts/Base.astro';
import { u } from '../lib/url';
---
<Base title="Open circuit">
  <div class="wrap">
    <section class="section">
      <span class="silk">Error 404 · open circuit</span>
      <h1>This trace doesn’t connect to anything.</h1>
      <p class="lede">The link might be old or mistyped. Let’s get you back on the board.</p>
      <div class="hero"><div class="cta"><a class="btn" href={u('/')}>Go home</a><a class="link" href={u('/log/')}>Read the log</a></div></div>
    </section>
  </div>
</Base>
