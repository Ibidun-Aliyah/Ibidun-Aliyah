---
import Base from '../layouts/Base.astro';
import { u } from '../lib/url';
---
<Base title="Page not found">
  <section class="masthead compact">
    <div class="decor" data-decor aria-hidden="true"></div>
    <div class="wrap inner">
      <span class="eyebrow">404</span>
      <h1>This page wandered off the breadboard</h1>
      <p class="lede">The link might be old or mistyped.</p>
      <div class="cta"><a class="btn" href={u('/')}>Go home</a><a class="ghost" href={u('/blog/')}>Read the log</a></div>
    </div>
  </section>
</Base>
