---
import Base from '../layouts/Base.astro';
import Robot from '../components/Robot.astro';
import Board from '../components/Board.astro';
import Legend from '../components/Legend.astro';
import { getPosts } from '../lib/posts';
import { SITE } from '../site.config';
import { u } from '../lib/url';

const posts = (await getPosts()).slice(0, 5);
---
<Base>
  <section class="hero">
    <svg class="traces" viewBox="0 0 1200 560" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
      <path d="M1200 90H1010L960 140V230" /><circle cx="960" cy="236" r="7" />
      <path d="M1200 470H1060L1010 420H900" /><circle cx="894" cy="420" r="7" />
      <path d="M0 520H260L300 480H520" /><circle cx="526" cy="480" r="7" />
      <path d="M640 0V40L690 90H780" /><circle cx="786" cy="90" r="7" />
    </svg>
    <div class="wrap">
      <div class="copy">
        <span class="silk">Mechatronics engineering · <b>LASUSTECH</b> · Lagos</span>
        <h1>Hi, I’m Aliyah. I build little robots for <mark>big human problems.</mark></h1>
        <p class="lede">I’m a Mechatronics Engineering student working towards AI, robotics and embedded systems. This board is where I log everything I build, teach, organise and learn.</p>
        <div class="cta">
          <a class="btn" href={u('/log/')}>Read the log</a>
          <a class="link" href={u('/about/')}>Open my datasheet</a>
        </div>
      </div>
      <Robot />
    </div>
  </section>

  <div class="wrap">
    <section class="section" aria-labelledby="latest-h">
      <div class="section-head">
        <div class="titles"><span class="silk">The log · latest</span><h2 id="latest-h">Fresh off the board</h2></div>
        <a class="link" href={u('/log/')}>See every post</a>
      </div>
      <div class="board-layout">
        <Board posts={posts} />
        <Legend />
      </div>
    </section>

    <section class="section" id="say-hi" aria-labelledby="hi-h">
      <div class="connector">
        <div class="pins" aria-hidden="true"><i></i><i></i><i></i><i></i></div>
        <span class="silk">J1 · Connector</span>
        <h2 id="hi-h">Say hi</h2>
        <p class="lede">I’m open to collaborations, internships and projects in AI and robotics, smart systems and IoT, EdTech, and community-led innovation.</p>
        <span class="email">{SITE.email}</span>
        <div class="contact-links">
          <a class="btn" href={`mailto:${SITE.email}`}>Email me</a>
          {SITE.linkedin && <a class="link" href={SITE.linkedin} rel="me">LinkedIn</a>}
          {SITE.instagram && <a class="link" href={SITE.instagram} rel="me">Instagram</a>}
          {SITE.github && <a class="link" href={SITE.github} rel="me">GitHub</a>}
        </div>
      </div>
    </section>
  </div>
</Base>
