---
import Base from '../layouts/Base.astro';
---
<Base title="About" description="About Aliyah Ibidun Ibiwunmi: Mechatronics Engineering at LASUSTECH, RAIN-INN campus lead, Microsoft Learn Student Ambassador, and builder of AI and robotics projects.">
  <section class="masthead compact">
    <div class="decor" data-decor aria-hidden="true"></div>
    <div class="wrap inner">
      <span class="eyebrow">About</span>
      <h1>Engineering as a tool to <mark>solve human problems</mark></h1>
      <p class="lede">I’m Aliyah, a Mechatronics Engineering student at LASUSTECH with a deep interest in AI, robotics and embedded systems. I don’t wait for the classroom. I build my own learning paths and blend coursework with personal projects, community leadership and self-study.</p>
    </div>
  </section>

  <div class="wrap">
    <section class="section" aria-labelledby="int-h">
      <h2 id="int-h">What I’m into</h2>
      <div class="chips">
        <span class="chip">AI for robotics and automation</span>
        <span class="chip">Smart systems for urban safety and mobility</span>
        <span class="chip">Embedded hardware and IoT</span>
        <span class="chip">Human-centred tech for developing contexts</span>
        <span class="chip">AI for education and infrastructure</span>
      </div>
    </section>

    <section class="section" aria-labelledby="edu-h">
      <h2 id="edu-h">Education</h2>
      <div class="card">
        <span class="kind">2024 to present</span>
        <h3>B.Eng. Mechatronics Engineering, Lagos State University of Science and Technology</h3>
        <p>Current CGPA 4.24 / 5.00, the highest in my 200-level cohort. Building a base across mechanical, electrical, computer science and control systems.</p>
        <p>Key courses so far: Engineering Mathematics II, Strength of Materials, Thermodynamics, Engineering Materials, and Philosophy &amp; Logic.</p>
      </div>
    </section>

    <section class="section" aria-labelledby="lead-h">
      <h2 id="lead-h">Leadership</h2>
      <ul class="timeline">
        <li><span class="when">2025 to present</span><h3>Campus Lead, Robotics and Artificial Intelligence Innovators Network (RAIN-INN)</h3><span>Running hands-on AI and ML workshops for beginners, growing a student robotics and AI community, and planning hackathons with national leadership and mentors.</span></li>
        <li><span class="when">2025 to present</span><h3>Microsoft Learn Student Ambassador</h3><span>Learning and sharing Microsoft technologies through workshops and learning challenges.</span></li>
        <li><span class="when">2025 to present</span><h3>Campus Ambassador, Cowrywise</h3><span>Promoting financial literacy and a saving culture among students.</span></li>
        <li><span class="when">2025 to present</span><h3>Assistant General Secretary, NAMES LASUSTECH</h3><span>Serving mechatronics engineering students in the National Association of Mechatronics Engineering Students.</span></li>
      </ul>
    </section>

    <section class="section two-col" aria-label="Skills and current learning">
      <div class="prose">
        <h2>Skills</h2>
        <ul>
          <li>Arduino prototyping with sensors, actuators and breadboard circuits</li>
          <li>Beginner robotics and embedded systems</li>
          <li>Microsoft Learn AI and cloud tools</li>
          <li>Leadership, project management and community engagement</li>
          <li>Google Workspace, Notion and spreadsheets</li>
        </ul>
      </div>
      <div class="prose">
        <h2>Currently learning</h2>
        <ul>
          <li>Embedded systems and hardware development</li>
          <li>Robotics fundamentals</li>
          <li>Microsoft AI and cloud learning paths</li>
          <li>Blockchain development basics</li>
        </ul>
      </div>
    </section>
  </div>
</Base>
