---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { u, formatDate } from '../../lib/url';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---
<Base title="The log" description="Aliyah Ibidun Ibiwunmi's log: projects, workshops, coursework notes and everything else from a Mechatronics Engineering student in Lagos.">
  <section class="masthead compact">
    <div class="decor" data-decor aria-hidden="true"></div>
    <div class="wrap inner">
      <span class="eyebrow">The log</span>
      <h1>Everything I build, learn and organise</h1>
      <p class="lede">Projects, workshops, coursework takeaways and the odd lesson learned the hard way. Newest first.</p>
    </div>
  </section>
  <div class="wrap">
    <section class="section">
      <div class="cards">
        {posts.map((p) => (
          <a class="card" href={u(`/blog/${p.id}/`)}>
            <span class="kind">{p.data.tags[0] ?? 'Log'}</span>
            <h3>{p.data.title}</h3>
            <p>{p.data.description}</p>
            <span class="meta"><time datetime={p.data.date.toISOString()}>{formatDate(p.data.date)}</time></span>
          </a>
        ))}
      </div>
    </section>
  </div>
</Base>
